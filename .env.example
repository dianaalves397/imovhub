# Values safe to expose to the browser. Find them in Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Financial transaction flows remain disabled until legal/fiscal validation.
NEXT_PUBLIC_ENABLE_FINANCIAL_TRANSACTIONS=false
